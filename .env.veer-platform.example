# Veer Platform API Configuration (Development)
#
# Set these environment variables to connect Veer desktop to the Veer Platform API
# for authentication and account management.
#
# DO NOT commit this file with real values. Copy to .env.veer-platform.local
# and source it before running `pnpm dev`.

# Required: Veer Platform API base URL (development)
export ORCA_CLOUD_API_URL="https://veer-api.rahuljangir-works.workers.dev"

# Required: Auth0 client ID (get from Auth0 dashboard)
# This is safe to share - it's not a secret
export ORCA_CLOUD_CLIENT_ID="<your-auth0-client-id>"

# Optional: Auth0 scopes (default shown below)
# export ORCA_CLOUD_AUTH_SCOPE="openid profile email offline_access"

# Usage:
# 1. Copy this file: cp .env.veer-platform.example .env.veer-platform.local
# 2. Edit .env.veer-platform.local with your Auth0 client ID
# 3. Source it: source .env.veer-platform.local
# 4. Run dev: pnpm dev
#
# The desktop will use the Veer Platform API for authentication.
# All 7 desktop auth routes (/v1/desktop/auth/*) will be served by the Platform API.
